.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, .94);
  border-radius: 0;
  border-top: 1rpx solid #edf0f7;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 50;
  box-shadow: 0 -10rpx 36rpx rgba(44, 54, 88, .08);
  backdrop-filter: blur(18rpx);
}

.tab-item {
  width: 50%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a8396;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  position: relative;
  box-sizing: border-box;
}

.tab-item.active {
  color: #5a4bf4;
  font-weight: var(--weight-bold);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  display: block;
}

.tabbar {
  left: 0;
  right: 0;
  bottom: 0;
  height: 146rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 -18rpx 48rpx rgba(38, 48, 86, .075);
}

.tab-item {
  height: 100%;
  padding-top: 0;
  font-size: var(--font-md);
}

.tab-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 9rpx;
}
