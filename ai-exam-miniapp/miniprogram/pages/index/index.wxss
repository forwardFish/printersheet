.index-page {
  background: linear-gradient(180deg, #fbfcff 0%, #f8f9ff 45%, #ffffff 100%);
}

.index-container {
  padding-top: 8rpx;
}

.hero-card {
  width: 100%;
  height: auto;
  border-radius: 24rpx;
  overflow: hidden;
  display: block;
  box-shadow: 0 12rpx 34rpx rgba(92, 81, 190, .08);
}

.points-row {
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-left {
  display: flex;
  align-items: center;
  color: #181b25;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
}

.coin-icon {
  width: 60rpx;
  height: 58rpx;
  margin-right: 24rpx;
}

.points-num {
  margin-left: 14rpx;
  font-size: var(--font-hero);
  color: #5a4bf4;
}

.recent-upload-banner {
  display: block;
  width: 100%;
  border-radius: 24rpx;
  margin: 0 0 22rpx;
  box-shadow: 0 16rpx 40rpx rgba(92, 81, 190, .08);
}

.upgrade-pill {
  min-width: 278rpx;
  height: 58rpx;
  border-radius: 999rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #d96f00;
  background: linear-gradient(180deg, #fff8ea, #fff2d9);
  border: 1rpx solid #ffe0ad;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
}

.crown-mini {
  color: #f7a917;
  font-size: var(--font-body);
}

.pill-arrow {
  font-size: var(--font-page-title);
  line-height: 1;
}

.textarea-wrap {
  height: 180rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e3e7f1;
  background: rgba(255,255,255,.94);
  padding: 28rpx 28rpx 42rpx;
  position: relative;
  box-shadow: 0 12rpx 38rpx rgba(52, 61, 99, .05);
}

.prompt-input {
  width: 100%;
  height: 110rpx;
  color: #171923;
  font-size: var(--font-body);
  line-height: 42rpx;
}

.placeholder {
  color: #828ba2;
}

.counter {
  position: absolute;
  right: 26rpx;
  bottom: 22rpx;
  color: #737c91;
  font-size: var(--font-sm);
}

.smart-hint {
  margin: 14rpx 6rpx 0;
  color: #5d50f1;
  font-size: var(--font-sm);
  line-height: 34rpx;
}

.prompt-guard {
  margin: 14rpx 4rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e7eaf3;
  background: #fbfcff;
}

.prompt-guard.needs_detail {
  border-color: #dfe3ef;
}

.prompt-guard.invalid {
  border-color: #ffd4bf;
  background: #fff8f4;
}

.prompt-guard-text {
  color: #6f788c;
  font-size: var(--font-sm);
  line-height: 34rpx;
}

.prompt-guard.invalid .prompt-guard-text {
  color: #c45c2c;
}

.suggestion-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-chip {
  min-height: 58rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ded9ff;
  background: #fff;
  color: #5d50f1;
  font-size: var(--font-sm);
  line-height: 34rpx;
  font-weight: var(--weight-bold);
  padding: 12rpx 18rpx;
}

.quick-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx;
  margin-top: 22rpx;
}

.quick-card {
  height: 82rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e7eaf3;
  background: rgba(255,255,255,.94);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171923;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
  box-shadow: 0 12rpx 32rpx rgba(50, 60, 102, .06);
}

.quick-card.active {
  border-color: #a99fff;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  display: block;
  flex: 0 0 auto;
}

.arrow {
  color: #7f8798;
  margin-left: 16rpx;
}

.select-panel {
  margin-top: 22rpx;
  padding: 26rpx 26rpx 18rpx;
}

.select-panel.compact {
  padding-bottom: 28rpx;
}

.select-head,
.option-title {
  color: #151924;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.select-group-title {
  color: #758097;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  margin: 20rpx 0 12rpx;
}

.select-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx 20rpx;
}

.subject-grid {
  margin-top: 22rpx;
}

.select-option {
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fbfcff, #f6f7fb);
  border: 1rpx solid #e4e8f2;
  color: #1c2130;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}

.select-option.active {
  border-color: #6655ff;
  color: #5948f4;
  font-weight: var(--weight-bold);
  box-shadow: inset 0 0 0 1rpx #6655ff;
}

.cost-card {
  min-height: 112rpx;
  margin-top: 22rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
}

.doc-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  display: block;
  flex: 0 0 auto;
}

.cost-copy {
  flex: 1;
}

.cost-title {
  color: #171923;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.cost-desc {
  color: #707a91;
  font-size: var(--font-sm);
  margin-top: 8rpx;
}

.cost-num {
  min-width: 94rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #f0edff;
  color: #5a4bf4;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-options {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #737c91;
  font-size: var(--font-md);
}

.toggle-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f6f4ff;
  color: #5a4bf4;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.toggle-arrow::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-right: 4rpx solid #5a4bf4;
  border-bottom: 4rpx solid #5a4bf4;
  transform: translateY(-3rpx) rotate(45deg);
  transition: transform .18s ease;
}

.toggle-arrow.expanded::after {
  transform: translateY(3rpx) rotate(225deg);
}

.more-panel {
  padding: 28rpx;
}

.mode-row {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx 22rpx;
}

.mode-chip {
  min-height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fbfcff, #f5f6fb);
  border: 1rpx solid #e3e7f0;
  color: #596276;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  position: relative;
}

.mode-chip.active {
  color: #5a4bf4;
  border-color: #6655ff;
  background: #fbfaff;
  font-weight: var(--weight-bold);
}

.mode-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #5a4bf4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  font-size: var(--font-xs);
}

.generate-btn {
  margin-top: 24rpx;
}

.task-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  border-radius: 22rpx;
  border: 1rpx solid #e5e8f2;
  background: rgba(255,255,255,.96);
  box-shadow: 0 14rpx 42rpx rgba(54, 62, 105, .07);
  overflow: hidden;
}

.task-list-head {
  min-height: 88rpx;
  padding: 22rpx 24rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.task-list.collapsed .task-list-head {
  padding-bottom: 22rpx;
}

.task-list-title {
  color: #171923;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 38rpx;
}

.task-list-subtitle {
  margin-top: 4rpx;
  color: #858ea2;
  font-size: var(--font-xs);
  line-height: 30rpx;
}

.task-head-right {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-list-count {
  min-width: 54rpx;
  height: 44rpx;
  border-radius: 999rpx;
  padding: 0 14rpx;
  background: #f0edff;
  color: #5a4bf4;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}


.task-card {
  margin: 0 22rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-top: 1rpx solid #eef1f7;
}

.task-collapsed-row {
  min-height: 78rpx;
  margin: 0 22rpx 22rpx;
  border-top: 1rpx solid #eef1f7;
  color: #5a4bf4;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #171923;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta,
.task-message {
  color: #7b8498;
  font-size: var(--font-xs);
  line-height: 32rpx;
  margin-top: 4rpx;
}

.task-progress {
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #eceefa;
  overflow: hidden;
}

.task-progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #745cff, #4f46f2);
}

.task-status {
  min-width: 96rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5a4bf4;
  background: #f0edff;
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
}

.task-status.succeeded {
  color: #fff;
  background: #5a4bf4;
}

.task-status.failed {
  color: #d64242;
  background: #fff0f0;
}

.task-record-link {
  margin: 4rpx 22rpx 22rpx;
  min-height: 82rpx;
  border-radius: 18rpx;
  border: 1rpx dashed #c8c0ff;
  background: #fbfaff;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-record-title {
  color: #5a4bf4;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.task-record-desc {
  margin-top: 4rpx;
  color: #7f8798;
  font-size: var(--font-mini);
}

.task-record-arrow {
  color: #5a4bf4;
  font-size: var(--font-hero);
  font-weight: var(--weight-bold);
}

.upload-card {
  margin-top: 20rpx;
