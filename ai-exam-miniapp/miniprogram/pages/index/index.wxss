  width: 170rpx;
  height: 170rpx;
  margin-right: 38rpx;
  font-size: 0;
  background: url('/assets/logo-ai.png') center/contain no-repeat;
}

.screenshot-recent .upload-title {
  font-size: var(--font-section);
}

.screenshot-recent .upload-desc {
  font-size: var(--font-body);
  margin-top: 22rpx;
}

.task-list {
  margin-top: 30rpx;
  border-radius: 26rpx;
}

.task-list-head {
  min-height: 112rpx;
  padding: 30rpx 44rpx 20rpx;
}

.task-list-title {
  font-size: var(--font-page-title);
}

.task-list-count {
  min-width: 62rpx;
  height: 54rpx;
  font-size: var(--font-lg);
}

.task-card {
  margin: 0 34rpx;
  padding: 28rpx 0;
}

.task-title {
  font-size: var(--font-section);
  line-height: 44rpx;
}

.task-meta,
.task-message {
  font-size: var(--font-md);
  line-height: 38rpx;
}

.task-status {
  min-width: 146rpx;
  height: 66rpx;
  font-size: var(--font-body);
}

.task-record-link {
  margin: 18rpx 34rpx 34rpx;
  min-height: 122rpx;
  border-radius: 20rpx;
  padding: 0 30rpx;
}

.task-record-title {
  font-size: var(--font-title);
}

.task-record-desc {
  font-size: var(--font-body);
}

.last-card {
  min-height: 176rpx;
  margin-top: 24rpx;
  padding: 30rpx 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.last-label {
  color: #6b62e8;
  font-size: var(--font-sm);
  margin-bottom: 16rpx;
}

.last-title {
  color: #141827;
  font-size: var(--font-section);
  font-weight: var(--weight-bold);
}

.last-meta {
  margin-top: 14rpx;
  color: #707a91;
  font-size: var(--font-body);
}

.last-action {
  min-width: 150rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6b55ff, #5548ef);
  color: #fff;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.points-row {
  height: 100rpx;
  padding: 0 26rpx;
  gap: 18rpx;
}

.points-left {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.points-label {
  flex: 0 0 auto;
  color: #171923;
  font-size: var(--font-body);
  line-height: 34rpx;
  font-weight: var(--weight-bold);
  letter-spacing: 0;
}

.coin-icon {
  flex: 0 0 auto;
  width: 50rpx;
  height: 50rpx;
  margin-right: 18rpx;
}

.points-num {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #5a4bf4;
  font-size: var(--font-display);
  line-height: 1;
  font-weight: var(--weight-bold);
  letter-spacing: 0;
}

.upgrade-pill {
  flex: 0 0 auto;
  min-width: 0;
  width: 322rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  gap: 8rpx;
  font-size: var(--font-md);
  line-height: 1;
  font-weight: var(--weight-bold);
}

.upgrade-pill text {
  white-space: nowrap;
}

.crown-mini {
  font-size: var(--font-sm);
}

.pill-arrow {
  font-size: var(--font-title);
}

.quick-row {
  gap: 18rpx;
}

.quick-card {
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  justify-content: flex-start;
  gap: 14rpx;
  background: #fff;
  border-color: #e5e9f2;
  box-shadow: 0 8rpx 24rpx rgba(43, 53, 88, .06);
}

.quick-card.active {
  border-color: #d8d4ff;
  box-shadow: 0 10rpx 26rpx rgba(91, 76, 244, .10);
}

.quick-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 0;
  border-radius: 12rpx;
}

.quick-label {
  flex: 1 1 auto;
  min-width: 0;
  color: #171923;
  font-size: var(--font-lg);
  line-height: 38rpx;
  font-weight: var(--weight-bold);
  letter-spacing: 0;
  white-space: nowrap;
  text-align: center;
}

.arrow {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-left: 2rpx;
  border-right: 4rpx solid #8a93a6;
  border-bottom: 4rpx solid #8a93a6;
  transform: rotate(45deg);
  transform-origin: center;
  box-sizing: border-box;
}

.action-panel {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
}

.generate-btn {
  width: 420rpx;
  height: 86rpx;
  margin-top: 0;
  border-radius: 22rpx;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  letter-spacing: 0;
  box-shadow: 0 16rpx 34rpx rgba(83, 69, 238, .22);
}

.generate-btn.disabled {
  opacity: 1;
  color: rgba(255, 255, 255, .58);
  background: linear-gradient(135deg, #b9adff 0%, #9b8cf2 100%);
  box-shadow: none;
}

.upload-card {
  min-height: 126rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  border-color: #e4e8f3;
  background: #ffffff;
  display: flex;
  align-items: center;
  text-align: left;
  box-shadow: 0 16rpx 42rpx rgba(42, 52, 92, .07);
}

.upload-card.selected {
  border-color: #cfc8ff;
  background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
}

.upload-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  margin-right: 22rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #725cff 0%, #5146ee 100%);
  position: relative;
  box-shadow: 0 10rpx 20rpx rgba(83, 69, 238, .20);
}

.upload-icon::before {
  content: '';
  position: absolute;
  left: 25rpx;
  top: 15rpx;
  width: 8rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: #fff;
}

.upload-icon::after {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 14rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 7rpx solid #fff;
  border-top: 7rpx solid #fff;
  transform: rotate(45deg);
  border-radius: 3rpx;
}

.upload-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.upload-title {
  color: #1d2433;
  font-size: var(--font-lg);
  line-height: 38rpx;
  font-weight: var(--weight-bold);
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-desc {
  margin-top: 8rpx;
  color: #7c8598;
  font-size: var(--font-xs);
  line-height: 32rpx;
  font-weight: var(--weight-semibold);
}

.upload-arrow {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-left: 22rpx;
  border-right: 4rpx solid #9aa2b3;
  border-bottom: 4rpx solid #9aa2b3;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.remove-file {
  flex: 0 0 auto;
  height: 46rpx;
  margin-left: 18rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f2f0ff;
  color: #5a4bf4;
  font-size: var(--font-xs);
  line-height: 46rpx;
  font-weight: var(--weight-bold);
}
