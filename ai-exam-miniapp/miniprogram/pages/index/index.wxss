  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
}

.upload-icon {
  color: #5a4bf4;
  font-size: var(--font-page-title);
  margin-right: 16rpx;
}

.upload-copy {
