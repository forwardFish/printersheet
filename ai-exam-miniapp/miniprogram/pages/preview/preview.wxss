.preview-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcff 0%, #ffffff 100%);
  padding-bottom: 44rpx;
}

.tabs {
  height: 74rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e2e6f0;
  background: #fff;
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171923;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.tab.active {
  color: #5a4bf4;
  border: 2rpx solid #6655ff;
  border-radius: 16rpx;
  background: #fbfaff;
}

.paper-card {
  margin-top: 26rpx;
  padding: 44rpx 54rpx 30rpx;
  min-height: 970rpx;
  color: #111;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(47, 56, 94, .08);
}

.paper-title {
  text-align: center;
  color: #111;
  font-size: var(--font-section);
  font-weight: var(--weight-bold);
  margin-bottom: 38rpx;
}

.paper-meta {
  display: flex;
  justify-content: space-between;
  color: #111;
  font-size: var(--font-xs);
  margin-bottom: 34rpx;
}

.paper-section {
  margin-top: 18rpx;
}

.section-name {
  color: #111;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  margin-bottom: 18rpx;
}

.question {
  color: #111;
  font-size: var(--font-xs);
  line-height: 38rpx;
  margin-bottom: 16rpx;
}

.options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx 46rpx;
  padding-left: 36rpx;
  margin-top: 8rpx;
}

.diagram-box {
  width: 360rpx;
  height: 240rpx;
  margin: 16rpx 0 10rpx 42rpx;
  position: relative;
  overflow: hidden;
}

.geometry-diagram,
.number-line-diagram {
  width: 100%;
  height: 100%;
  position: relative;
}

.diagram-segment {
  position: absolute;
  height: 3rpx;
  background: #111;
  transform-origin: 0 50%;
}

.diagram-label,
.diagram-length,
.diagram-angle {
  position: absolute;
  transform: translate(-50%, -50%);
  color: #111;
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  line-height: 1;
}

.diagram-length {
  font-size: var(--font-mini);
  background: #fff;
  padding: 0 6rpx;
}

.diagram-angle {
  font-size: var(--font-mini);
  font-weight: var(--weight-semibold);
}

.diagram-right-mark {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-left: 3rpx solid #111;
  border-top: 3rpx solid #111;
  transform: translate(4rpx, -26rpx);
}

.number-line-axis {
  position: absolute;
  left: 0;
  right: 0;
  top: 48%;
  height: 3rpx;
  background: #111;
}

.number-line-tick,
.number-line-point {
  position: absolute;
  top: 48%;
  transform: translateX(-50%);
  color: #111;
  font-size: var(--font-mini);
}

.number-line-tick::before,
.number-line-point::before {
  content: '';
  display: block;
  width: 2rpx;
  height: 18rpx;
  margin: -8rpx auto 6rpx;
  background: #111;
}

.number-line-point::before {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: -5rpx;
}

.answer-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.answer-head {
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  line-height: 38rpx;
}

.answer-body {
  margin-top: 10rpx;
  color: #5b6577;
  font-size: var(--font-xs);
  line-height: 36rpx;
}

.page-index {
  margin: 24rpx auto 0;
  padding-top: 22rpx;
  width: 520rpx;
  border-top: 1rpx solid #dfe3eb;
  text-align: center;
  color: #7a8395;
  font-size: var(--font-sm);
  line-height: 34rpx;
}

.download-row {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.download-card {
  height: 96rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  padding: 0 34rpx;
  text-align: left;
  position: relative;
}

.download-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 24rpx;
}

.download-title {
  color: #171923;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
}

.download-sub {
  color: #6f788c;
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.lock {
  margin-left: auto;
  color: #7e8799;
}

.regen {
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171923;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
}

.upgrade-card {
  height: 120rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
  border: 1rpx solid #f4d79b;
  background: linear-gradient(135deg, #fff9ec, #fffdf8);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.upgrade-crown {
  width: 72rpx;
  height: 72rpx;
  margin-right: 26rpx;
  border-radius: 16rpx;
}

.upgrade-copy {
  flex: 1;
}

.upgrade-copy view {
  color: #d77b00;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.upgrade-copy text {
  color: #6d7689;
  font-size: var(--font-sm);
  margin-top: 8rpx;
  display: block;
}

.upgrade-card button {
  width: 142rpx;
  height: 66rpx;
  border-radius: 12rpx;
  color: #fff;
  background: linear-gradient(135deg, #6b55ff, #5548ef);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.inline-status {
  color: #5a4bf4;
  text-align: center;
  margin-top: 18rpx;
  font-size: var(--font-sm);
}

.tabs {
  width: 690rpx;
  margin-left: auto;
  margin-right: auto;
  height: 88rpx;
  border-radius: 26rpx;
  border: 0;
  background: rgba(243, 244, 250, .88);
}

.tab {
  font-size: var(--font-title);
  color: #72798b;
}

.tab.active {
  border: 0;
  border-radius: 26rpx;
  background: #fff;
  color: #5a4bf4;
  box-shadow: 0 14rpx 34rpx rgba(84, 72, 200, .12);
}

.paper-card {
  margin-top: 30rpx;
  margin-left: 44rpx;
  margin-right: 44rpx;
  min-height: 958rpx;
  border-radius: 28rpx;
  padding: 54rpx 48rpx 30rpx;
}

.paper-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #cdc6ff;
  margin-bottom: 42rpx;
}

.paper-brand {
  color: #111827;
  font-size: var(--font-title);
  font-weight: var(--weight-bold);
}

.paper-brand text {
  color: #5f4df3;
  margin-right: 4rpx;
}

.paper-tags {
  color: #6a5af4;
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
}

.paper-title {
  font-size: var(--font-title);
  margin-bottom: 28rpx;
}

.paper-meta {
  justify-content: center;
  gap: 72rpx;
  font-size: var(--font-xs);
}

.section-name {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f2efff;
  color: #5a4bf4;
}

.question {
  font-size: var(--font-xs);
  line-height: 42rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx dashed #d8dce8;
}

.page-index {
  color: #5a4bf4;
  border-top: 0;
  font-weight: var(--weight-bold);
}

.download-row {
  gap: 32rpx;
}

.download-card {
  height: 136rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #7d5cff, #5548ef);
  color: #fff;
  border: 0;
  box-shadow: 0 18rpx 36rpx rgba(84, 70, 238, .22);
}

.download-card:nth-child(2) {
  background: linear-gradient(135deg, #4e8dff, #286ff0);
}

.download-title,
.download-sub {
  color: #fff;
}

.download-title {
  font-size: var(--font-title);
}

.regen {
  height: 96rpx;
  border-radius: 22rpx;
  color: #5a4bf4;
  font-size: var(--font-title);
}

.preview-page {
  background:
    radial-gradient(circle at 22% 8%, rgba(95, 78, 240, .055), transparent 30%),
    linear-gradient(180deg, #fbfcff 0%, #ffffff 68%);
}

.tabs {
  height: 78rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
}

.tab {
  font-size: var(--font-lg);
}

.paper-card {
  min-height: 980rpx;
