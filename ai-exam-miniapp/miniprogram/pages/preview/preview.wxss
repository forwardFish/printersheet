}

.question {
  font-size: var(--font-xs);
  line-height: 40rpx;
}

.download-card {
  height: 104rpx;
  border-radius: 18rpx;
}

.download-icon {
  width: 64rpx;
  height: 64rpx;
}

.regen {
  height: 86rpx;
}

.upgrade-card {
  height: 126rpx;
  border-radius: 20rpx;
}

.download-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
}

.download-card {
  flex: 0 0 300rpx;
  width: 300rpx;
  min-width: 0;
  height: 104rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.download-icon-wrap {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(32, 42, 90, .10);
}

.download-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 0;
  display: block;
}

.download-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.download-title {
  font-size: var(--font-md);
  line-height: 33rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.download-sub {
  font-size: var(--font-mini);
  line-height: 28rpx;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lock {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: rgba(255, 255, 255, .85);
}
