.packages-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcff 0%, #ffffff 100%);
  padding-bottom: 48rpx;
}

.top-card {
  height: 224rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6e4fff 0%, #584af1 100%);
  color: #fff;
  padding: 34rpx;
  display: flex;
  justify-content: space-between;
  overflow: hidden;
  margin: 22rpx 0 26rpx;
  position: relative;
}

.top-card::after {
  content: '';
  position: absolute;
  right: 120rpx;
  bottom: -44rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
}

.top-copy {
  width: 500rpx;
  position: relative;
  z-index: 1;
}

.top-title {
  font-size: var(--font-hero);
  font-weight: var(--weight-bold);
  margin-bottom: 30rpx;
}

.top-desc {
  font-size: var(--font-body);
  line-height: 42rpx;
  opacity: .9;
}

.top-crown {
  position: absolute;
  right: 50rpx;
  bottom: 12rpx;
  width: 170rpx;
  height: 150rpx;
  z-index: 1;
}

.top-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.top-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(105, 76, 255, .84) 0%, rgba(105, 76, 255, .48) 52%, rgba(105, 76, 255, .04) 100%);
  z-index: 1;
}

.top-copy {
  z-index: 2;
}

.current-card {
  min-height: 132rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.current-label {
  color: #7a8398;
  font-size: var(--font-sm);
  line-height: 34rpx;
}

.current-title {
  margin-top: 6rpx;
  color: #171923;
  font-size: var(--font-section);
  line-height: 40rpx;
  font-weight: var(--weight-bold);
}

.current-date {
  margin-top: 8rpx;
  color: #7a8398;
  font-size: var(--font-md);
  line-height: 36rpx;
}

.current-points {
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1efff;
  color: #5a4bf4;
  font-size: var(--font-md);
  line-height: 58rpx;
  font-weight: var(--weight-bold);
  text-align: center;
}

.section-title {
  margin: 28rpx 0 18rpx;
  color: #171923;
  font-size: var(--font-section);
  line-height: 42rpx;
  font-weight: var(--weight-bold);
}

.plan-card {
  position: relative;
  min-height: 250rpx;
  padding: 30rpx 34rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 52rpx rgba(46, 56, 96, .07);
}

.plan-card.selected {
  border-color: #6655ff;
  background: linear-gradient(135deg, #fff 0%, #fbfaff 100%);
  box-shadow: 0 18rpx 50rpx rgba(90, 75, 244, .1);
}

.plan-card.disabled {
  opacity: .68;
}

.plan-card.disabled .radio {
  background: #eef1f7;
  border-color: #d8deea;
  color: transparent;
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-name {
  color: #171923;
  font-size: var(--font-section);
  font-weight: var(--weight-bold);
}

.plan-name.blue {
  color: #5a4bf4;
}

.tag {
  min-width: 92rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #ffe7f1;
  color: #f33e83;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 54rpx;
}

.tag.default {
  margin-right: 0;
}

.tag.state {
  min-width: 128rpx;
  margin-right: 54rpx;
  background: #eef1f7;
  color: #667085;
}

.price-row {
  margin: 24rpx 0 22rpx;
  display: flex;
  align-items: baseline;
  color: #171923;
}

.yen {
  font-size: var(--font-page-title);
  font-weight: var(--weight-bold);
}

.price {
  font-size: var(--font-price);
  line-height: 1;
  font-weight: var(--weight-bold);
  letter-spacing: 0;
}

.period {
  color: #798296;
  font-size: var(--font-body);
  margin-left: 10rpx;
}

.benefit {
  color: #737c91;
  font-size: var(--font-md);
  line-height: 44rpx;
  display: flex;
  align-items: center;
}

.benefit text {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #5a4bf4;
  color: #fff;
  font-size: var(--font-micro);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.radio {
  position: absolute;
  right: 34rpx;
  top: 58rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #a4adbf;
  color: #fff;
  font-size: var(--font-body);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  background: #5a4bf4;
  border-color: #5a4bf4;
}

.upgrade-main {
  margin-top: 18rpx;
}

.point-pack {
  position: relative;
  min-height: 128rpx;
  padding: 28rpx 96rpx 28rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 38rpx rgba(46, 56, 96, .06);
}

.point-pack.selected {
  border-color: #6655ff;
  box-shadow: 0 18rpx 42rpx rgba(90, 75, 244, .1);
}

.pack-name {
  color: #171923;
  font-size: var(--font-title);
  line-height: 40rpx;
  font-weight: var(--weight-bold);
}

.pack-desc {
  margin-top: 8rpx;
  color: #7a8398;
  font-size: var(--font-md);
  line-height: 36rpx;
}

.pack-side {
  text-align: right;
}

.pack-points {
  color: #5a4bf4;
  font-size: var(--font-title);
  line-height: 40rpx;
  font-weight: var(--weight-bold);
}

.pack-price {
  margin-top: 8rpx;
  color: #171923;
  font-size: var(--font-md);
  line-height: 34rpx;
  font-weight: var(--weight-semibold);
}

.packages-page {
  background:
    radial-gradient(circle at 18% 8%, rgba(97, 80, 244, .055), transparent 30%),
    linear-gradient(180deg, #fbfcff 0%, #ffffff 68%);
}

.top-card {
  height: 176rpx;
  margin-top: 24rpx;
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  padding: 34rpx 34rpx 28rpx;
}

.top-title {
  font-size: var(--font-page-title);
  margin-bottom: 18rpx;
}

.top-desc {
  font-size: var(--font-md);
  line-height: 38rpx;
}

.top-crown {
  right: 42rpx;
  bottom: 8rpx;
  width: 144rpx;
  height: 128rpx;
}

.plan-card {
  min-height: 240rpx;
  border-radius: 20rpx;
  padding: 32rpx 34rpx;
  margin-bottom: 24rpx;
}

.plan-card.selected {
  box-shadow: 0 20rpx 50rpx rgba(90, 75, 244, .12);
}

.plan-name {
  font-size: var(--font-section);
}

.price {
  font-size: var(--font-price);
}

.benefit {
  font-size: var(--font-body);
  line-height: 46rpx;
}

.radio {
  width: 48rpx;
  height: 48rpx;
}

.upgrade-main {
  height: 96rpx;
  border-radius: 18rpx;
  margin-top: 20rpx;
}
