PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DB_PROVIDER=local
FILE_PROVIDER=local
PAYMENT_PROVIDER=wechat
PAYMENT_TEST_MODE=true
WECHAT_PAY_TEST_AMOUNT_CENTS=1
LOCAL_DB_PATH=./.data/dev-db.json
AUTH_SECRET=replace-with-a-local-dev-secret
CLOUDBASE_ENV_ID=aiassistant-0517-d6en8tw82f2f7fc
WECHAT_APP_ID=wx1e662dd78e2fb22e
WECHAT_APP_SECRET=

# Real WeChat Pay JSAPI. Local test payments use 1 cent while PAYMENT_TEST_MODE=true.
# Set PAYMENT_TEST_MODE=false in production to charge the normal product prices.
# Use file paths for private keys/certs where possible; do not commit real key material.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_MERCHANT_CERT_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_DESCRIPTION=AI题卷宝-点数套餐
# Local callback debugging only; never enable this in production.
WECHAT_PAY_SKIP_NOTIFY_SIGNATURE=false
GENERATION_JOB_CONCURRENCY=3
GENERATION_JOB_TIMEOUT_MS=600000

# Local CloudBase access. Do not commit real values.
# TENCENTCLOUD_SECRETID=
# TENCENTCLOUD_SECRETKEY=

AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_WORKSHEET_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_MS=600000

# Compatibility variables. If AI_* is empty, the server can read these.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Disabled for worksheet generation. If set to true, generation fails instead of returning demo/mock questions.
AI_MOCK_MODE=false

# Disabled for worksheet generation. Real AI failures are surfaced to the user; no mock fallback is allowed.
AI_FALLBACK_TO_MOCK=false

# Optional PDF CJK font.
# PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
